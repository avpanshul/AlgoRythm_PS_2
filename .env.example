POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ulp_db
POSTGRES_USER=ulp
POSTGRES_PASSWORD=changeme-generate-a-strong-password

KAFKA_BROKERS=redpanda:29092

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=changeme-generate-a-strong-secret

MINIO_SECURE=false

OPENSEARCH_URL=http://opensearch:9200

REDIS_URL=redis://redis:6379/0

OLLAMA_URL=http://ollama:11434
# Real bug found live (2026-09-28 audit): phi3:mini was never pulled on the
# dev/demo machine, so every LLM-assisted field-mapping call 404'd. Defaults
# to a model actually confirmed installed/working during that audit; `ollama
# pull <model>` whichever you set here -- the compose file's ollama service
# doesn't auto-pull anything.
OLLAMA_MODEL=llama3.2:latest
# Also found live: CPU-only inference with the real production prompt
# reliably needs more than the old hardcoded 60s. Raise for slower hardware,
# lower for GPU-backed Ollama.
OLLAMA_TIMEOUT_SECONDS=90

EMBEDDING_MODEL=all-MiniLM-L6-v2

# JWT signing secret -- REQUIRED. Generate with: openssl rand -hex 32
# If unset, the app will boot with an auto-generated, process-lifetime-only secret
# and print a warning (all tokens invalidated on restart). Set REQUIRE_JWT_SECRET=true
# to instead fail startup hard when this is missing.
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
REQUIRE_JWT_SECRET=false

# Initial admin account. Set a real password here to have the app create this account
# on first startup (only if no user with this email exists yet). Leave blank to skip
# auto-creating an admin account.
ADMIN_INITIAL_EMAIL=admin@ulpf.local
ADMIN_INITIAL_PASSWORD=changeme-set-a-strong-initial-password

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

RISK_WEIGHTS={"severity": 0.3, "action": 0.2, "frequency": 0.2, "asset": 0.15, "correlation": 0.15}
CONFIDENCE_THRESHOLDS={"auto_approve": 0.90, "review": 0.70}

AIRGAPPED_MODE=true

# Raw log vault (bronze tier) encryption at rest. REQUIRED for real use.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, the vault is still gzip-compressed but NOT encrypted, and the app
# prints a startup warning rather than refusing to boot.
VAULT_ENCRYPTION_KEY=changeme-generate-a-fernet-key

# Column-level encryption at rest for specific sensitive DB columns (Part D4)
# -- e.g. User.mfa_secret. Separate key from VAULT_ENCRYPTION_KEY on purpose
# (different blast radius if one leaks). Generate the same way:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, those columns are stored in plaintext with a startup warning.
DB_ENCRYPTION_KEY=changeme-generate-a-fernet-key

# MFA (TOTP) + account lockout (Part D1).
MFA_ISSUER_NAME=ULPF
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15
MFA_PREAUTH_EXPIRE_MINUTES=5

# Ingest-scoped tokens (Part D1) -- see POST /admin/ingest-tokens.
INGEST_TOKEN_EXPIRE_DAYS=365

# Item 2: spark detection (app/services/spark_detection.py). Off by default.
ENABLE_SPARK_DETECTION=false
SPARK_RISK_THRESHOLD=80
# Real scale finding: this project's own demo DB already had 132 entities at
# the default threshold; each spark does a real O(n) attack-path scan, so
# this caps how many NEW risk-threshold sparks are created per 30s cycle.
SPARK_MAX_NEW_PER_CYCLE=5

# Item 3: backlog re-parse (app/services/auto_reparse.py). Off by default.
ENABLE_AUTO_REPARSE=false
AUTO_REPARSE_BATCH_SIZE=100

# Item 4: Drain3 template-store persistence (app/ai/drain3_engine.py). Off
# by default; the counter-reseed collision-prevention safety net (see that
# file's docstring) applies regardless of this flag.
ENABLE_DRAIN_PERSIST=false

# Item 5: agent refine loop (app/services/pack_drafting.py). Off by default;
# single-pass classification (Item 1) is the fallback either way.
ENABLE_AGENT_REFINE=false
AGENT_REFINE_MAX_ATTEMPTS=3

# Scheduled checkpoint self-verification -- re-walks old checkpoints, not
# just issuing new ones. See app/workers/checkpoint_scheduler.py.
CHECKPOINT_REVERIFY_INTERVAL_HOURS=24
CHECKPOINT_REVERIFY_BATCH_SIZE=5

# RFC 3161 trusted timestamping (app/integrity/rfc3161.py). Unset by default
# (air-gapped -- this is an outbound call to a third party). A real free
# public TSA for testing: http://freetsa.org/tsr
RFC3161_TSA_URL=
RFC3161_TIMEOUT_SECONDS=10
RFC3161_TSA_CA_CERT_PATH=
RFC3161_TSA_UNTRUSTED_CERT_PATH=

# Multi-party checkpoint witnessing (app/integrity/witness.py). Comma-separated
# hex Ed25519 public keys this instance accepts an external cosignature from.
WITNESS_TRUSTED_PUBLIC_KEYS=
AUTO_WITNESS_LOCAL=true

# Syslog UDP/TCP listener (app/workers/syslog_listener.py), run as its own process.
SYSLOG_LISTEN_HOST=0.0.0.0
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
